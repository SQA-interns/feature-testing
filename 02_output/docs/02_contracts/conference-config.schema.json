{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conference-config.schema.json",
  "title": "Conference options and consents (AR-04, BR-04, OQ-01, OQ-02)",
  "description": "Loaded from the resource named by CONFERENCE_CONFIG at start-up; the backend refuses to start when the file does not satisfy this schema or has duplicate option or consent ids (AC-003-03).",
  "type": "object",
  "additionalProperties": false,
  "required": ["options", "consents"],
  "properties": {
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" }
    },
    "consents": {
      "type": "array",
      "items": { "$ref": "#/$defs/consent" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "category": { "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
        "active": { "type": "boolean" },
        "availableTo": {
          "description": "Registration types the option is offered to; missing means both (OQ-01)",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["EXTERNAL", "STUDENT"] }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "mandatory"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "mandatory": { "type": "boolean" }
      }
    }
  }
}
