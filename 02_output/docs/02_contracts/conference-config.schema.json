{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conference-config.schema.json",
  "title": "Conference configuration: options and consents (AR-04, OQ-01, OQ-02)",
  "type": "object",
  "additionalProperties": false,
  "required": ["options", "consents"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "registrationType": { "type": "string", "enum": ["EXTERNAL", "STUDENT"] }
  },
  "properties": {
    "options": {
      "type": "array",
      "description": "Option ids are unique across the list; a duplicate refuses start",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "category": { "type": "string", "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
          "active": { "type": "boolean", "default": true },
          "availableTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/registrationType" },
            "default": ["EXTERNAL", "STUDENT"]
          }
        }
      }
    },
    "consents": {
      "type": "array",
      "description": "Consent ids are unique across the list",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "mandatory": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
