{
  "openapi": "3.1.0",
  "info": {
    "title": "Conference registration API",
    "version": "1.0.0",
    "description": "Exactly the API fixed by project/02_design/api-contract.md (AR-09). Every 400 body lists one error per invalid field; 401, 403, 413, 429 and 500 use the same error shape and never carry registration data."
  },
  "servers": [{ "url": "http://127.0.0.1:8080", "description": "local stack" }],
  "paths": {
    "/api/form-config": {
      "get": {
        "operationId": "getFormConfig",
        "summary": "Active options, consents and the reCAPTCHA site key (public)",
        "responses": {
          "200": {
            "description": "Form configuration; only active options (AC-003-01)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FormConfig" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/registrations": {
      "post": {
        "operationId": "register",
        "summary": "Submit a registration (public, reCAPTCHA protected)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Accepted: stored in the database and as a JSON copy",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Created" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "get": {
        "operationId": "searchRegistrations",
        "summary": "Search and list registrations (organizer)",
        "security": [{ "organizerBasic": [] }],
        "parameters": [
          { "name": "text", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 100 } },
          { "name": "type", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/RegistrationType" } },
          { "name": "option", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "At most 20 registrations, newest first, with the total number of matches",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/HttpsRequired" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/export": {
      "get": {
        "operationId": "exportRegistrations",
        "summary": "Excel workbook of every registration (organizer)",
        "security": [{ "organizerBasic": [] }],
        "responses": {
          "200": {
            "description": "First sheet: header row id, type, firstName, lastName, email, organization, studyInstitution, studyProgramme, studentId, options, consents, registeredAt; then one row per registration. options and consents are ids joined by ', '; cells of the other type are empty.",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/HttpsRequired" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "organizerBasic": { "type": "http", "scheme": "basic", "description": "ORGANIZER_USERNAME / ORGANIZER_PASSWORD" }
    },
    "schemas": {
      "RegistrationType": { "type": "string", "enum": ["EXTERNAL", "STUDENT"] },
      "OptionCategory": { "type": "string", "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
      "FormOption": {
        "type": "object",
        "required": ["id", "name", "category", "availableTo"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "$ref": "#/components/schemas/OptionCategory" },
          "availableTo": { "type": "array", "items": { "$ref": "#/components/schemas/RegistrationType" } }
        }
      },
      "FormConsent": {
        "type": "object",
        "required": ["id", "text", "mandatory"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "mandatory": { "type": "boolean" }
        }
      },
      "FormConfig": {
        "type": "object",
        "required": ["options", "consents", "captchaSiteKey"],
        "properties": {
          "options": { "type": "array", "items": { "$ref": "#/components/schemas/FormOption" } },
          "consents": { "type": "array", "items": { "$ref": "#/components/schemas/FormConsent" } },
          "captchaSiteKey": { "type": "string" },
          "captchaTestMode": { "type": "boolean", "description": "Additional optional field: true when CAPTCHA_TEST_MODE is on" }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "required": ["type", "firstName", "lastName", "email", "options", "consents", "captchaToken"],
        "properties": {
          "type": { "$ref": "#/components/schemas/RegistrationType" },
          "firstName": { "type": "string", "maxLength": 100 },
          "lastName": { "type": "string", "maxLength": 100 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "organization": { "type": ["string", "null"], "maxLength": 200, "description": "required for EXTERNAL" },
          "studyInstitution": { "type": ["string", "null"], "maxLength": 200, "description": "required for STUDENT" },
          "studyProgramme": { "type": ["string", "null"], "maxLength": 200, "description": "required for STUDENT" },
          "studentId": { "type": ["string", "null"], "maxLength": 50, "description": "required for STUDENT" },
          "options": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string" } },
          "consents": { "type": "array", "items": { "type": "string" } },
          "captchaToken": { "type": "string" }
        }
      },
      "Created": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "format": "uuid" } }
      },
      "SearchItem": {
        "type": "object",
        "required": ["id", "type", "firstName", "lastName", "email", "organization", "studyInstitution", "options", "registeredAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "$ref": "#/components/schemas/RegistrationType" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "organization": { "type": ["string", "null"] },
          "studyInstitution": { "type": ["string", "null"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "registeredAt": { "type": "string", "format": "date-time" }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": ["total", "page", "items"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/SearchItem" } }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["errors"],
        "properties": { "errors": { "type": "array", "items": { "$ref": "#/components/schemas/FieldError" } } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Rejected: one error per invalid field (request field or query parameter name)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "Unauthorized": {
        "description": "No valid organizer credentials; no registration data",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "HttpsRequired": {
        "description": "ORGANIZER_HTTPS_ONLY is on and the request is plain HTTP from a non-local client (D-11); no registration data",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "PayloadTooLarge": {
        "description": "Body over MAX_REQUEST_BYTES",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "TooManyRequests": {
        "description": "Over RATE_LIMIT_PER_MINUTE for this client and endpoint",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "ServerError": {
        "description": "The registration could not be stored (AC-005-03); no internal details",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      }
    }
  }
}
