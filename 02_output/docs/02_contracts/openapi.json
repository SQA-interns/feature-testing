{
  "openapi": "3.1.0",
  "info": {
    "title": "Conference registration API",
    "version": "1.0.0",
    "description": "Exactly the API fixed by project/02_design/api-contract.md (AR-09)."
  },
  "servers": [{ "url": "http://127.0.0.1:8080", "description": "local stack" }],
  "components": {
    "securitySchemes": {
      "organizerBasic": { "type": "http", "scheme": "basic" }
    },
    "schemas": {
      "RegistrationType": { "type": "string", "enum": ["EXTERNAL", "STUDENT"] },
      "OptionCategory": { "type": "string", "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
      "Option": {
        "type": "object",
        "required": ["id", "name", "category", "availableTo"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "$ref": "#/components/schemas/OptionCategory" },
          "availableTo": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RegistrationType" }
          }
        }
      },
      "Consent": {
        "type": "object",
        "required": ["id", "text", "mandatory"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "mandatory": { "type": "boolean" }
        }
      },
      "FormConfig": {
        "type": "object",
        "required": ["options", "consents", "captchaSiteKey"],
        "properties": {
          "options": { "type": "array", "items": { "$ref": "#/components/schemas/Option" } },
          "consents": { "type": "array", "items": { "$ref": "#/components/schemas/Consent" } },
          "captchaSiteKey": { "type": "string" },
          "captchaTestMode": { "type": "boolean" }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "properties": {
          "type": { "type": ["string", "null"], "description": "EXTERNAL or STUDENT" },
          "firstName": { "type": ["string", "null"] },
          "lastName": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"] },
          "organization": { "type": ["string", "null"], "description": "required for EXTERNAL" },
          "studyInstitution": { "type": ["string", "null"], "description": "required for STUDENT" },
          "studyProgramme": { "type": ["string", "null"], "description": "required for STUDENT" },
          "studentId": { "type": ["string", "null"], "description": "required for STUDENT" },
          "options": { "type": ["array", "null"], "items": { "type": "string" } },
          "consents": { "type": ["array", "null"], "items": { "type": "string" } },
          "captchaToken": { "type": ["string", "null"] }
        }
      },
      "RegistrationCreated": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string" } }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ValidationErrors": {
        "type": "object",
        "required": ["errors"],
        "properties": {
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/FieldError" } }
        }
      },
      "GeneralError": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "SearchItem": {
        "type": "object",
        "required": ["id", "type", "firstName", "lastName", "email", "organization", "studyInstitution", "options", "registeredAt"],
        "properties": {
          "id": { "type": "string" },
          "type": { "$ref": "#/components/schemas/RegistrationType" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "organization": { "type": ["string", "null"] },
          "studyInstitution": { "type": ["string", "null"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "registeredAt": { "type": "string", "format": "date-time" }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": ["total", "page", "items"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/SearchItem" }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Field errors, one entry per invalid field",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrors" } } }
      },
      "Unauthorized": {
        "description": "Missing or wrong organizer credentials; no registration data",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralError" } } }
      },
      "Forbidden": {
        "description": "Organizer request over plain HTTP from a client that is not on localhost while ORGANIZER_HTTPS_ONLY is on (D-10); no registration data",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralError" } } }
      },
      "TooManyRequests": {
        "description": "Over RATE_LIMIT_PER_MINUTE for this client and endpoint",
        "headers": { "Retry-After": { "schema": { "type": "integer" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralError" } } }
      }
    }
  },
  "paths": {
    "/api/form-config": {
      "get": {
        "operationId": "getFormConfig",
        "summary": "Active options, consents and the captcha site key (AC-003-01)",
        "responses": {
          "200": {
            "description": "Form configuration",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FormConfig" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Submit a registration",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Accepted and stored",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationCreated" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": {
            "description": "Request body larger than REQUEST_MAX_BYTES",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralError" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": {
            "description": "The registration could not be stored (AC-005-03)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralError" } } }
          },
          "503": {
            "description": "The captcha could not be verified; nothing stored",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralError" } } }
          }
        }
      },
      "get": {
        "operationId": "searchRegistrations",
        "summary": "Organizer search (US-009)",
        "security": [{ "organizerBasic": [] }],
        "parameters": [
          { "name": "text", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 100 } },
          { "name": "type", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/RegistrationType" } },
          { "name": "option", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Matching registrations, newest first, at most 20",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/export": {
      "get": {
        "operationId": "exportRegistrations",
        "summary": "Excel export of all registrations (US-008)",
        "security": [{ "organizerBasic": [] }],
        "responses": {
          "200": {
            "description": "Workbook; first sheet row 1: id, type, firstName, lastName, email, organization, studyInstitution, studyProgramme, studentId, options, consents, registeredAt",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  }
}
