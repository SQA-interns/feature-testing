{
  "openapi": "3.1.0",
  "info": {
    "title": "Conference registration API",
    "version": "1.0.0",
    "description": "Fixed by project/02_design/api-contract.md (AR-09). Bodies are application/json; charset=utf-8 except the export. Every endpoint is rate limited per client and endpoint (RATE_LIMIT_PER_MINUTE, HTTP 429) and request bodies are limited to MAX_REQUEST_BYTES (HTTP 413) (SR-03)."
  },
  "servers": [{ "url": "http://127.0.0.1:8080", "description": "local stack (docker-compose.yml)" }],
  "paths": {
    "/api/form-config": {
      "get": {
        "operationId": "getFormConfig",
        "summary": "Active options, consents and the reCAPTCHA site key (public)",
        "security": [],
        "responses": {
          "200": {
            "description": "Form configuration; only active options (AC-003-01)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FormConfig" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Submit a registration (public, reCAPTCHA protected)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Accepted: the database row and the JSON copy are written (AR-05)",
            "headers": { "Location": { "schema": { "type": "string" }, "description": "/api/registrations/{id}" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Created" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/GeneralError" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/GeneralError" }
        }
      }
    },
    "/api/export": {
      "get": {
        "operationId": "exportRegistrations",
        "summary": "Excel export of all registrations (organizer, HTTP Basic)",
        "security": [{ "organizerBasic": [] }],
        "responses": {
          "200": {
            "description": "Workbook; first sheet, row 1 = column headers in the order of x-columns, then one row per registration ordered by registeredAt",
            "headers": { "Content-Disposition": { "schema": { "type": "string" }, "description": "attachment; filename=\"registrations.xlsx\"" } },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" },
                "x-columns": ["id", "type", "firstName", "lastName", "email", "organization", "studyInstitution", "studyProgramme", "studentId", "options", "consents", "registeredAt"],
                "x-cell-rules": "options and consents: ids joined by ', '; a cell that does not apply to the type is empty; registeredAt ISO 8601 UTC; every cell is a string cell"
              }
            }
          },
          "401": {
            "description": "No or wrong organizer credentials; no registration data (AC-008-02)",
            "headers": { "WWW-Authenticate": { "schema": { "type": "string" } } }
          },
          "403": {
            "description": "Valid credentials over plain HTTP from a non-loopback client while ORGANIZER_HTTPS_ONLY=true (AC-008-04, SR-06); no registration data",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralErrorBody" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "organizerBasic": { "type": "http", "scheme": "basic", "description": "ORGANIZER_USERNAME / ORGANIZER_PASSWORD from .env" }
    },
    "responses": {
      "ValidationFailed": {
        "description": "Rejected; nothing stored, no email sent",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrors" } } }
      },
      "TooManyRequests": {
        "description": "Over RATE_LIMIT_PER_MINUTE for this client and endpoint",
        "headers": { "Retry-After": { "schema": { "type": "integer" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralErrorBody" } } }
      },
      "PayloadTooLarge": {
        "description": "Body larger than MAX_REQUEST_BYTES",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralErrorBody" } } }
      },
      "GeneralError": {
        "description": "Registration could not be stored or another server error; no internal details (AC-005-03, SB-07)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeneralErrorBody" } } }
      }
    },
    "schemas": {
      "RegistrationType": { "type": "string", "enum": ["EXTERNAL", "STUDENT"] },
      "OptionCategory": { "type": "string", "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
      "FormOption": {
        "type": "object",
        "required": ["id", "name", "category", "availableTo"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "$ref": "#/components/schemas/OptionCategory" },
          "availableTo": { "type": "array", "items": { "$ref": "#/components/schemas/RegistrationType" }, "minItems": 1, "uniqueItems": true }
        }
      },
      "FormConsent": {
        "type": "object",
        "required": ["id", "text", "mandatory"],
        "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "mandatory": { "type": "boolean" } }
      },
      "FormConfig": {
        "type": "object",
        "required": ["options", "consents", "captchaSiteKey", "captchaTestMode"],
        "properties": {
          "options": { "type": "array", "items": { "$ref": "#/components/schemas/FormOption" } },
          "consents": { "type": "array", "items": { "$ref": "#/components/schemas/FormConsent" } },
          "captchaSiteKey": { "type": "string", "description": "RECAPTCHA_SITE_KEY; empty in test mode without a key" },
          "captchaTestMode": { "type": "boolean", "description": "additional optional field: true when CAPTCHA_TEST_MODE=true; the frontend then shows the test-mode check instead of the Google widget" }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "required": ["type", "firstName", "lastName", "email", "options", "consents", "captchaToken"],
        "properties": {
          "type": { "$ref": "#/components/schemas/RegistrationType" },
          "firstName": { "type": "string", "maxLength": 200 },
          "lastName": { "type": "string", "maxLength": 200 },
          "email": { "type": "string", "maxLength": 254 },
          "organization": { "type": ["string", "null"], "maxLength": 200, "description": "required for EXTERNAL, ignored for STUDENT" },
          "studyInstitution": { "type": ["string", "null"], "maxLength": 200, "description": "required for STUDENT, ignored for EXTERNAL" },
          "studyProgramme": { "type": ["string", "null"], "maxLength": 200, "description": "required for STUDENT, ignored for EXTERNAL" },
          "studentId": { "type": ["string", "null"], "maxLength": 200, "description": "required for STUDENT, ignored for EXTERNAL" },
          "options": { "type": "array", "items": { "type": "string" }, "description": "distinct active option ids available to the type; null or missing = none" },
          "consents": { "type": "array", "items": { "type": "string" }, "description": "ids of the consents given; every mandatory consent must be listed" },
          "captchaToken": { "type": "string", "description": "reCAPTCHA v2 response; in test mode only 'test-pass' is accepted" }
        }
      },
      "Created": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "format": "uuid" } }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string", "description": "request field name (type, firstName, lastName, email, organization, studyInstitution, studyProgramme, studentId, options, consents, captchaToken) or 'body' for an unreadable body" },
          "message": { "type": "string" }
        }
      },
      "ValidationErrors": {
        "type": "object",
        "required": ["errors"],
        "properties": { "errors": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/FieldError" } } }
      },
      "GeneralErrorBody": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string", "description": "short text without technical details" } }
      }
    }
  }
}
